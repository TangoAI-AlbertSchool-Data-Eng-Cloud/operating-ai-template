# Copy this file to .env (never committed) to change the lab's settings.

# A port already taken on your machine? Pick another one here.
# GATEWAY_PORT=8400
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Optional, billed: a real model instead of the stand-in (see LAB.md).
# Lower the traffic in compose.yaml first.
# LLM_MODE=real
# ANTHROPIC_API_KEY=sk-ant-...
